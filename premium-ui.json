{
  "profile": "product-admin",
  "sourceRoots": ["frontend/app", "frontend/components"],
  "locale": "th-TH",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Date", "Form", "Scrollbar", "CRUD"],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "native",
    "Form": "native",
    "Scrollbar": "global-css",
    "CRUD": "route-api"
  },
  "requiredCommands": ["lint", "build"],
